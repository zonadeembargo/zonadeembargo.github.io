---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Mascote from './Mascote.astro';
import { CATEGORIAS, u, dataBR } from '../config';
// nivel: 2 em listas logo abaixo do <h1>; 3 quando há um <h2> de seção antes (ex.: home)
interface Props { entry: CollectionEntry<'textos'>; nivel?: 2 | 3 }
const { entry, nivel = 2 } = Astro.props;
const H = nivel === 3 ? "h3" : "h2";
const d = entry.data;
const cat = CATEGORIAS[d.categoria];
const href = u(`textos/${entry.id}/`);
---
<article class={`placa card card--${cat.cor}`}>
  <a class="card__img" href={href} tabindex="-1" aria-hidden="true">
    {d.capa
      ? <Image class="capa" src={d.capa} alt="" widths={[360, 720]} sizes="(min-width:640px) 230px, 100vw" />
      : <Mascote nome={cat.mascote} />}
  </a>
  <div class="card__txt">
    <a class={`tag tag--${cat.cor}`} href={u(`categoria/${d.categoria}/`)}>[{cat.rotulo}]</a>
    {d.rascunho && <span class="tag tag--laranja">RASCUNHO</span>}
    <H class="card__titulo"><a href={href}>{d.titulo}</a></H>
    <p>{d.resumo}</p>
    <span class="meta"><time datetime={d.data.toISOString()}>{dataBR(d.data)}</time> · {d.autor}</span>
  </div>
</article>

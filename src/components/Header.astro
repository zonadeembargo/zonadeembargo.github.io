---
import { SITE, NAV, SECOES, u } from '../config';
const atual = Astro.url.pathname;
const ativo = (href: string) => (href === '' ? atual === u() : atual.startsWith(u(href)));
---
<header class="topo">
  <div class="wrap">
    <a class="marca" href={u()} aria-label={`${SITE.projeto}, por ${SITE.nome} — página inicial`}>
      <img src={u('emblema-120.webp')} srcset={`${u('emblema-120.webp')} 1x, ${u('emblema-240.webp')} 2x`} alt="" width="60" height="60" />
      <span>
        <span class="marca__titulo">{SITE.projeto}</span>
        <span class="marca__assinatura">por {SITE.nome}</span>
      </span>
    </a>
    <nav class="nav" aria-label="Principal">
      {NAV.map((i) => (
        <a href={u(i.href)} aria-current={ativo(i.href) ? 'page' : undefined}>{i.rotulo}<small>{i.sub}</small></a>
      ))}
      <a class="nav__busca" href={u(SECOES.busca.href)} aria-current={ativo(SECOES.busca.href) ? 'page' : undefined}>
        <span aria-hidden="true">⌕</span><small>{SECOES.busca.sub}</small>
      </a>
    </nav>
  </div>
  <div class="barras" aria-hidden="true"><i></i><i></i></div>
</header>

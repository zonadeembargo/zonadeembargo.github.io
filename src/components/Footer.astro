---
import { SITE, SECOES, u } from '../config';
const links = [SECOES.manifesto, SECOES.busca, SECOES.licencas, SECOES.institucional];
---
<footer class="rodape">
  <div class="barras" aria-hidden="true"><i></i><i></i></div>
  <div class="wrap">
    <div>
      <p>{SITE.aviso}</p>
      <p>
        <strong>Textos, mapas, dados e imagens de conteúdo:</strong> <a href={SITE.licencaUrl} rel="license">{SITE.licenca}</a>.
        <strong>Código do site:</strong> <a href={SITE.licencaCodigoUrl}>{SITE.licencaCodigo}</a>.
        <strong>Logo e mascote:</strong> todos os direitos reservados. Ilustrações geradas com auxílio de IA.
      </p>
    </div>
    <nav aria-label="Rodapé">
      {links.map((s) => <a href={u(s.href)}>{s.rotulo}<small>{s.sub}</small></a>)}
      <a href={u('rss.xml')}>RSS<small>Feed</small></a>
      {SITE.substack && <a href={SITE.substack}>SUBSTACK<small>Externo ↗</small></a>}
      {SITE.apoio && <a href={SITE.apoio}>APOIAR<small>Externo ↗</small></a>}
      {SITE.canais.map((c) => <a href={c.url} rel="me">{c.nome.toUpperCase()}<small>Externo ↗</small></a>)}
    </nav>
  </div>
</footer>

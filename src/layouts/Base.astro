---
import '@fontsource/black-ops-one/400.css';
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/700.css';
import '@fontsource/share-tech-mono/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, u } from '../config';

// artigo: dados extras quando a página é um texto (ativa og:type=article e JSON-LD).
interface Artigo { publicado: Date; atualizado?: Date; autor: string; secao?: string; tags?: string[] }
interface Props { titulo?: string; descricao?: string; imagem?: string; semIndexar?: boolean; artigo?: Artigo }
const { titulo, descricao = SITE.descricao, imagem = u('img/og.jpg'), semIndexar = false, artigo } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITE.projeto}` : `${SITE.nome} · ${SITE.projeto}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(imagem, Astro.site); // imagem: caminho já com BASE (use u()) ou endereço completo
const jsonld = artigo && {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: titulo, description: descricao, image: og.href, url: canonical.href, inLanguage: 'pt-BR',
  datePublished: artigo.publicado.toISOString(),
  dateModified: (artigo.atualizado ?? artigo.publicado).toISOString(),
  author: { '@type': 'Person', name: artigo.autor },
  keywords: artigo.tags?.join(', ') || undefined,
  license: SITE.licencaUrl,
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={u('favicon-32.png')} />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.projeto} href={u('rss.xml')} />
    {semIndexar && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={artigo ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.projeto} />
    {artigo && <meta property="article:published_time" content={artigo.publicado.toISOString()} />}
    {artigo?.atualizado && <meta property="article:modified_time" content={artigo.atualizado.toISOString()} />}
    {artigo?.secao && <meta property="article:section" content={artigo.secao} />}
    {artigo?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#121415" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo"><slot /></main>
    <Footer />
  </body>
</html>

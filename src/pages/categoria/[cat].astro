---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import CabecalhoSecao from '../../components/CabecalhoSecao.astro';
import FiltroTemas from '../../components/FiltroTemas.astro';
import { getCollection } from 'astro:content';
import { CATEGORIAS, type CategoriaChave } from '../../config';
export function getStaticPaths() {
  return Object.keys(CATEGORIAS).map((cat) => ({ params: { cat } }));
}
const cat = Astro.params.cat as CategoriaChave;
const info = CATEGORIAS[cat];
const todos = (await getCollection('textos', ({ data }) => data.categoria === cat && (!data.rascunho || import.meta.env.DEV)))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
---
<Base titulo={info.rotulo} descricao={info.descricao}>
  <div class="wrap">
    <CabecalhoSecao rotulo={info.rotulo} sub="Tema" descricao={info.descricao} mascote={info.mascote}>
      <FiltroTemas atual={cat} />
    </CabecalhoSecao>
    <div class="lista">
      {todos.length ? todos.map((t) => <Card entry={t} />) : <p class="sub">Ainda não há textos neste tema.</p>}
    </div>
  </div>
</Base>

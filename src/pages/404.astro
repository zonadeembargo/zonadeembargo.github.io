---
import Base from '../layouts/Base.astro';
import { u } from '../config';
---
<Base titulo="Página não encontrada" semIndexar>
  <div class="wrap">
    <h1 class="titulo-pagina">Sinal não encontrado</h1>
    <div class="placa vazio">
      <img src={u('mascote/mascote-tira-duvidas-400.webp')} alt="" style="width:160px" />
      <p>Esta página não existe ou mudou de lugar. <a href={u()}>Voltar ao início</a> ou ver <a href={u('textos/')}>todos os textos</a>.</p>
    </div>
  </div>
</Base>
